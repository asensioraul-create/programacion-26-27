Algoritmo Ejercicio3_PRG
	
	Definir num1 , num2 Como Entero;
	
	
	Escribir 'Escribeme por pantalla el numero 1 y el numero 2';
	Leer num1;
	Leer num2;
	
	Si (num1==num2) Entonces
		Escribir ' El ' num2 ' es igual que ' num1;
	FinSi
	
	Si num1<num2 Entonces
		Escribir ' El ' num2 ' es mas grande que ' num1;
	SiNo
		Escribir 'El ' num1 ' es mas grande que ' num2;
	Fin Si
	
	
	
	
	
FinAlgoritmo
